<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.base.setup</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="0"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='languages']" position="before">
                    <div id="stock_accounting">
                        <block title="Stock Accounting" id="stock_accounting_div">
                            <setting string="Automatic Stock Accounting"
                                     help="Enable use of automatic inventory valuation"
                                     title="Enable use of automatic inventory valuation"
                                     name="stock_accounting_setting_container">
                                <field name="group_stock_accounting_automatic"/>
                            </setting>
                        </block>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
